+    def test_cross_section_fields(self):
+        from xsection.widgets import Fields
+
+        class Shown:
+            name = "a"
+            on = True
+
+        fields, roots = [], []
+        for _ in range(10):
+            root = tk.Tk()
+            window = tk.Toplevel(root)
+            changes = []
+            f = Fields(window, changes.append)
+            name, on = f.var("name"), f.var("on", "bool")
+            f.load(Shown())
+            name.set("b")
+            self.assertEqual(changes, ["name"])
+            window.destroy()
+            self.assertEqual((name.trace_info(), on.trace_info()), ([], []))
+            name.set("c")  # no callback on the destroyed owner
+            self.assertEqual(changes, ["name"])
