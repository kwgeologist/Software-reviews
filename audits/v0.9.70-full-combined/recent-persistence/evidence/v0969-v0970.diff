+        # The hints follow the width shown: never wider than the body leaves them.
+        for label in tab._hints:
+            self.assertEqual(int(str(label.cget("wraplength"))), max(100, scroller.canvas.winfo_width() - 16))
+            self.assertLessEqual(label.winfo_reqwidth(), scroller.body.winfo_width())
