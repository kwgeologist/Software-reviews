+class _Seismic(base._AppCase):
+    def setUp(self):
+        super().setUp()
+        self.app.tk.eval("proc bgerror {message} {lappend ::v0970_bgerrors $message}")
+
+    def bgerrors(self) -> list[str]:
+        try:
+            return list(self.app.tk.splitlist(self.app.tk.eval("set ::v0970_bgerrors")))
+        except tk.TclError:
+            return []
+
+    def fault(self, m, name="FP1", at=1):
+        app = self.app
+        if not app.registry.id_of("Horizon", "H1"):
+            app.new_object("Horizon", "H1")
+        app.set_active("Horizon", "H1")
+        tab = m.open_drawings()
+        tab.start("fault")
+        tab.nodes = [tuple(map(float, p)) for p in outline(at, at + 1, 2, 8)]
+        return tab.finish(name=name)
+
+    def manager(self, m):
+        return m.drawing_window, m.drawing_tab, m.drawing_tab.panel.scroll_frame
