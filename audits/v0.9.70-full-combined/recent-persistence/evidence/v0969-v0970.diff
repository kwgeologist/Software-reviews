+    def test_a_flipping_scroll_bar_stays_on(self):
+        """A body whose height follows the bar the wrong way (taller without the bar, shorter
+        with it) used to show and hide it for ever; it is held shown and the layout stops."""
+        root = self.app
+        top = tk.Toplevel(root)
