@@ -0,0 +1,465 @@
+"""v0.9.70: Tk lifecycle of Seismic's Map drawings panel and its neighbours (targeted Tk/Seismic
+audit).
+
+TK-AUD-001  the Map drawings panel's layout settles (its hints wrap to the width shown, never to
+            their own; a scroll bar that would only flip on and off stays on), and the project
+            tree's rebuild after a polygon's Finish no longer drains Tk's idle work - Finish
+            returns at once even while a layout is still busy.
+TK-AUD-002  each Map drawings panel unbinds its own keys from the Seismic window when it goes, on
+            every way it can go; nothing of a closed panel stays alive.
+TK-AUD-003  callbacks waiting for a map, a scroll frame or the application are cancelled before
+            their owner is destroyed.
+TK-AUD-004  the Find well trace and the Cross Section Fields traces go with their owners; destroyed
+            Tk roots can be collected.
+
+Event processing here is bounded (``drain``: one event at a time, a fixed number at most), so a
+layout that never settles fails the test instead of hanging it."""
+
+from __future__ import annotations
+
+import gc
+import sys
+import time
+import tkinter as tk
+import unittest
+import weakref
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import _tkinter  # noqa: E402
+
+import test_v0968_seismic as base  # noqa: E402
+from test_v0968_seismic import outline  # noqa: E402
+
+from ogcore import scrollframe  # noqa: E402
+
+HAVE_DISPLAY = base.HAVE_DISPLAY
+EVENTS = _tkinter.ALL_EVENTS | _tkinter.DONT_WAIT
+
+
+def drain(widget, limit: int = 20000) -> int:
+    """Process Tk's waiting events one at a time until none is left; the number processed, or
+    ``limit`` if they never ran out (a layout that never settles)."""
+    for n in range(limit):
+        if not widget.tk.dooneevent(EVENTS):
+            return n
+    return limit
+
+
+def pending_scripts(widget) -> list[str]:
+    """The scripts of the callbacks waiting in this interpreter (``after info``)."""
+    out = []
+    for job in widget.tk.splitlist(widget.tk.call("after", "info")):
+        try:
+            out.append(str(widget.tk.splitlist(widget.tk.call("after", "info", job))[0]))
+        except tk.TclError:
+            pass
+    return out
+
+
+def key_bindings(top) -> int:
+    return sum(
+        len([line for line in top.bind(k).split("\n") if line.strip()])
+        for k in ("<Return>", "<Escape>", "<Delete>", "<BackSpace>")
+    )
+
+
+def collected(refs) -> int:
+    gc.collect()
+    return sum(r() is not None for r in refs)
+
