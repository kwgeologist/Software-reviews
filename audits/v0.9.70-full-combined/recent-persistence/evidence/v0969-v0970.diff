+        self.assertEqual(win.winfo_reqwidth(), natural)
+        tab.cancel()
+        self.settled(win, "hint cleared")
+        self.assertEqual(win.winfo_reqwidth(), natural)
+        # Display scalings, natural size, and widths and heights either side of the scroll bar.
+        for scaling in (1.0, 1.25, 1.5, 1.75, 2.0, 1.0):
+            self.app.tk.call("tk", "scaling", scaling)
+            win.geometry("")
+            self.settled(win, f"scaling {scaling}")
+            for width, height in ((natural - 40, 260), (natural + 3, 900), (natural - 1, 420), (natural + 60, 300)):
+                win.geometry(f"{width}x{height}")
+                self.settled(win, f"{width}x{height} at {scaling}")
+        win.geometry(f"{natural}x200")  # short: the bar is shown
+        self.settled(win, "scroll bar on")
+        self.assertTrue(scroller.scrolling)
+        win.geometry(f"{natural}x900")  # tall: the bar is gone
+        self.settled(win, "scroll bar off")
+        self.assertFalse(scroller.scrolling)
