+class WaitingCallbacks(_Seismic):
+    def ours(self, scripts):
+        return [s for s in scripts if any(k in s for k in ("_run_pending", "update_layout", "_tree_scroll_now", "_well_filter"))]
+
+    def test_map_closed_right_after_a_refresh_is_asked_for(self):
+        app = self.app
+        m = self.the_map()
+        m.open_drawings()
+        drain(app)
+        m.schedule_horizon(5000)
+        m.drawing_tab.panel.scroll_frame._schedule()
+        self.assertTrue(self.ours(pending_scripts(app)))
+        m.panel.close()
+        self.assertEqual(self.ours(pending_scripts(app)), [])
+        drain(app)
+        self.assertEqual(self.bgerrors(), [])
+
+    def test_project_closed_right_after_a_refresh_is_asked_for(self):
+        app = self.app
+        m = self.the_map()
+        m.open_drawings()
+        drain(app)
+        m.schedule_horizon(5000)
+        app.well_find.set("W")
+        app.refresh_tree()
+        m.drawing_tab.panel.scroll_frame._schedule()
+        app.close_project()
+        self.assertEqual(self.ours(pending_scripts(app)), [])
+        # What is left is the application's own close-request watch, which lives as long as it does.
+        self.assertTrue(all("poll" in s for s in pending_scripts(app)), pending_scripts(app))
+        drain(app)
+        self.assertEqual(self.bgerrors(), [])
+
+    def test_panel_closed_during_a_pending_layout(self):
+        app = self.app
+        m = self.the_map()
+        m.open_drawings()
+        drain(app)
+        scroller = m.drawing_tab.panel.scroll_frame
+        scroller._schedule()
+        job = scroller._pending
+        self.assertIsNotNone(job)
+        m.dispose_drawings()
+        self.assertIsNone(scroller._pending)
+        self.assertNotIn(job, app.tk.splitlist(app.tk.call("after", "info")))
+        drain(app)
+        self.assertEqual(self.bgerrors(), [])
